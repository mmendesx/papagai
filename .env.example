# Example environment for local development and Docker Compose.
# Copy to `.env` in the repo root and set values (never commit `.env`).

# --- Required for docker-compose.yml (production stack) ---
# Compose fails fast if these are missing when you run `docker compose up`.
APP_KEY=
JWT_SECRET=
BASE_URL=

# --- Traefik Configuration ---
# Public domain for routing (e.g., yourdomain.com for prod, stage.yourdomain.com for staging)
TRAEFIK_DOMAIN=
# TLS certificate resolver name (should match your Traefik config)
TRAEFIK_CERT_RESOLVER=letsencrypt

# --- Production Stack Configuration ---
# Application environment and port
NODE_ENV=production
PORT=3000

# Allowed CORS origin(s) for the API.
# Defaults to http://localhost:4200 when unset (safe for local dev with the Angular frontend).
# Set to * to allow all origins (not recommended in production).
# Multiple origins: comma-separated, e.g. https://app.example.com,https://admin.example.com
CORS_ORIGIN=

# --- Database Configuration (for local development) ---
# Prisma requires a full DATABASE_URL (used by `prisma migrate` and the Prisma client at runtime).
# Pool parameters are appended as query params — Prisma does not read them from separate env vars.
# connection_limit: max connections in the pool (mirrors the previous TypeORM max: 10)
# pool_timeout:     seconds to wait for a free connection before throwing (mirrors connectionTimeoutMillis: 3000)
# socket_timeout:   seconds before an idle connection is evicted (mirrors idleTimeoutMillis: 30000)
DATABASE_URL=postgresql://papagai:papagai@localhost:5432/papagai?connection_limit=10&pool_timeout=3&socket_timeout=30

# --- Optional Feature Flags & Limits ---
# Dev-only: allow webhook URLs pointing to private/local addresses (e.g. localhost).
# Must be 'true' AND NODE_ENV=development to take effect. Never set in production.
WEBHOOK_ALLOW_PRIVATE_HOSTS=false

# Signed media URL lifetime in seconds (default: 24h).
MEDIA_URL_TTL_SECONDS=86400

# Maximum number of webhook delivery retries on failure (default: 3).
# Set to 0 to disable retries and preserve fire-and-forget behavior.
WEBHOOK_MAX_RETRIES=3

# API rate limiting for auth endpoints (throttler)
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=5
