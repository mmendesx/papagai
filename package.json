{
    "name": "papagai",
    "version": "1.0.0",
    "description": "Papagai is a self-hosted WhatsApp gateway with REST API, webhooks, signed media URLs, API keys, and an Angular dashboard.",
    "author": "Matheus Mendes",
    "private": true,
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "https://github.com/mmendesx/papagai"
    },
    "keywords": [
        "whatsapp",
        "api",
        "gateway",
        "multi-device",
        "webhook",
        "baileys",
        "papagai",
        "messaging",
        "whatsapp-api",
        "whatsapp-gateway"
    ],
    "scripts": {
        "build": "tsc -p tsconfig.build.json",
        "build:client": "npm run build --prefix client",
        "build:all": "npm run build && npm run build:client",
        "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
        "start": "nest start",
        "start:dev": "nest start --watch",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node dist/main",
        "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
        "lint:ci": "eslint \"{src,apps,libs,test}/**/*.ts\"",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:cov": "jest --coverage",
        "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
        "test:e2e": "jest --config ./test/jest-e2e.json --runInBand --forceExit",
        "prisma:generate": "prisma generate",
        "prisma:migrate": "prisma migrate dev",
        "prisma:migrate:deploy": "prisma migrate deploy",
        "prisma:studio": "prisma studio",
        "plan-review": "node -r ts-node/register scripts/plan-review/cli.ts",
        "test:plan-review": "jest --config test/plan-review/jest-plan-review.json --forceExit",
        "test:playwright": "playwright test"
    },
    "dependencies": {
        "@hapi/boom": "^10.0.1",
        "@nest-lab/throttler-storage-redis": "^1.2.0",
        "@nestjs/axios": "^4.0.1",
        "@nestjs/bullmq": "^11.0.4",
        "@nestjs/common": "^11.0.1",
        "@nestjs/config": "^4.0.3",
        "@nestjs/core": "^11.0.1",
        "@nestjs/jwt": "^11.0.2",
        "@nestjs/platform-express": "^11.0.1",
        "@nestjs/schedule": "^6.1.1",
        "@nestjs/serve-static": "^5.0.4",
        "@nestjs/swagger": "^11.2.7",
        "@nestjs/throttler": "^6.5.0",
        "@prisma/client": "^6.0.0",
        "@whiskeysockets/baileys": "7.0.0-rc13",
        "axios": "^1.15.2",
        "bcryptjs": "^3.0.3",
        "bullmq": "^5.76.2",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.14.1",
        "ioredis": "^5.4.0",
        "multer": "^2.1.1",
        "pg": "^8.13.0",
        "qrcode": "^1.5.4",
        "reflect-metadata": "^0.2.2",
        "rxjs": "^7.8.1"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.2.0",
        "@eslint/js": "^9.18.0",
        "@nestjs/cli": "^11.0.17",
        "@nestjs/schematics": "^11.0.0",
        "@nestjs/testing": "^11.0.1",
        "@playwright/test": "^1.59.1",
        "@types/bcrypt": "^6.0.0",
        "@types/bcryptjs": "^2.4.6",
        "@types/express": "^5.0.0",
        "@types/jest": "^30.0.0",
        "@types/multer": "^2.1.0",
        "@types/node": "^22.19.17",
        "@types/qrcode": "^1.5.5",
        "@types/supertest": "^6.0.2",
        "eslint": "^9.18.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-plugin-prettier": "^5.2.2",
        "globals": "^16.0.0",
        "jest": "^30.0.0",
        "prettier": "^3.4.2",
        "prisma": "^6.0.0",
        "rimraf": "^6.1.3",
        "source-map-support": "^0.5.21",
        "supertest": "^7.0.0",
        "ts-jest": "^29.2.5",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsconfig-paths": "^4.2.0",
        "typescript": "^5.7.3",
        "typescript-eslint": "^8.20.0"
    },
    "overrides": {
        "path-to-regexp": "8.4.2",
        "picomatch": "4.0.4",
        "music-metadata": "11.12.3",
        "lodash": "4.18.1",
        "axios": "^1.15.2",
        "glob": "^13.0.0",
        "inflight": "^1.0.6",
        "follow-redirects": "1.16.0",
        "fast-uri": "^3.1.2",
        "protobufjs": "^7.5.6",
        "@protobufjs/utf8": "^1.1.1",
        "protobufjs-cli": "^1.2.1"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": "src",
        "testRegex": ".*\\.spec\\.ts$",
        "transform": {
            "^.+\\.(t|j)s$": "ts-jest"
        },
        "moduleNameMapper": {
            "^@prisma/client$": "<rootDir>/__stubs__/prisma-client",
            "^@whiskeysockets/baileys$": "<rootDir>/__stubs__/baileys",
            "^(\\.{1,2}/.*)\\.js$": "$1"
        },
        "collectCoverageFrom": [
            "**/*.(t|j)s"
        ],
        "coverageDirectory": "../coverage",
        "testEnvironment": "node"
    }
}
