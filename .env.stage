# Staging environment for docker-compose.stage.yml
# Domain: https://stage.yourdomain.com
# Do not commit real secrets in this file.

# --- Required secrets ---
APP_KEY=change-me-stage-app-key
JWT_SECRET=change-me-stage-jwt-secret

# --- Public URLs / routing ---
BASE_URL=https://stage.yourdomain.com
TRAEFIK_CERT_RESOLVER=letsencrypt

# --- Runtime ---
NODE_ENV=production
PORT=3000

# Allowed frontend origin(s) for API calls
CORS_ORIGIN=https://stage.yourdomain.com

# --- Optional knobs ---
WEBHOOK_ALLOW_PRIVATE_HOSTS=false
MEDIA_URL_TTL_SECONDS=86400
WEBHOOK_MAX_RETRIES=3
AUTH_THROTTLE_TTL=60
AUTH_THROTTLE_LIMIT=5
